{
  "openapi": "3.0.0",
  "info": {
    "title": "jz_driving API",
    "version": "1.0.0",
    "description": "API for the jz_driving MERN application, managing users, courses, bookings, and more."
  },
  "servers": [
    {
      "url": "http://localhost:5000",
      "description": "Local development server"
    }
  ],
  "paths": {
    "/api/auth/register": {
      "post": {
        "summary": "Register a new user",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "name": { "type": "string" },
                  "email": { "type": "string" },
                  "phone": { "type": "string" },
                  "password": { "type": "string" },
                  "role": { "type": "string", "enum": ["customer", "instructor", "admin"] },
                  "address": {
                    "type": "object",
                    "properties": {
                      "city": { "type": "string" },
                      "country": { "type": "string" }
                    }
                  },
                  "profile": {
                    "type": "object",
                    "properties": {
                      "experience": { "type": "number" },
                      "specialization": { "type": "string" },
                      "availability": { "type": "array", "items": { "type": "string" } }
                    }
                  }
                },
                "required": ["name", "email", "phone", "password", "role"]
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "User registered successfully",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "_id": { "type": "string" },
                    "name": { "type": "string" },
                    "email": { "type": "string" },
                    "role": { "type": "string" },
                    "token": { "type": "string" }
                  }
                }
              }
            }
          },
          "400": {
            "description": "Invalid data or user exists"
          }
        }
      }
    },
    "/api/auth/login": {
      "post": {
        "summary": "Login a user",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "email": { "type": "string" },
                  "password": { "type": "string" }
                },
                "required": ["email", "password"]
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "User logged in successfully",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "_id": { "type": "string" },
                    "name": { "type": "string" },
                    "email": { "type": "string" },
                    "role": { "type": "string" },
                    "token": { "type": "string" }
                  }
                }
              }
            }
          },
          "401": {
            "description": "Invalid credentials"
          }
        }
      }
    },
    "/api/courses": {
      "post": {
        "summary": "Create a new course (Admin only)",
        "security": [{ "bearerAuth": [] }],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "title": { "type": "string" },
                  "description": { "type": "string" },
                  "durationHours": { "type": "number" },
                  "price": { "type": "number" },
                  "instructorId": { "type": "string" }
                },
                "required": ["title", "description", "durationHours", "price", "instructorId"]
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "Course created",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "_id": { "type": "string" },
                    "title": { "type": "string" },
                    "description": { "type": "string" },
                    "durationHours": { "type": "number" },
                    "price": { "type": "number" },
                    "instructorId": { "type": "string" }
                  }
                }
              }
            }
          },
          "400": {
            "description": "Invalid course data"
          }
        }
      },
      "get": {
        "summary": "Get all courses",
        "responses": {
          "200": {
            "description": "List of courses",
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": {
                    "type": "object",
                    "properties": {
                      "_id": { "type": "string" },
                      "title": { "type": "string" },
                      "description": { "type": "string" },
                      "durationHours": { "type": "number" },
                      "price": { "type": "number" },
                      "instructorId": {
                        "type": "object",
                        "properties": {
                          "name": { "type": "string" },
                          "email": { "type": "string" }
                        }
                      }
                    }
                  }
                }
              }
            }
          }
        }
      }
    },
    "/api/courses/{id}": {
      "put": {
        "summary": "Update a course (Admin only)",
        "security": [{ "bearerAuth": [] }],
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": { "type": "string" }
          }
        ],
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "title": { "type": "string" },
                  "description": { "type": "string" },
                  "durationHours": { "type": "number" },
                  "price": { "type": "number" },
                  "instructorId": { "type": "string" },
                  "status": { "type": "string", "enum": ["active", "inactive", "draft"] }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Course updated",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "_id": { "type": "string" },
                    "title": { "type": "string" },
                    "description": { "type": "string" },
                    "durationHours": { "type": "number" },
                    "price": { "type": "number" },
                    "instructorId": { "type": "string" },
                    "status": { "type": "string" }
                  }
                }
              }
            }
          },
          "404": {
            "description": "Course not found"
          }
        }
      },
      "delete": {
        "summary": "Delete a course (Admin only)",
        "security": [{ "bearerAuth": [] }],
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": { "type": "string" }
          }
        ],
        "responses": {
          "200": {
            "description": "Course removed",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "message": { "type": "string" }
                  }
                }
              }
            }
          },
          "404": {
            "description": "Course not found"
          }
        }
      }
    },
    "/api/bookings": {
      "post": {
        "summary": "Create a new booking",
        "security": [{ "bearerAuth": [] }],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "courseId": { "type": "string" },
                  "instructorId": { "type": "string" },
                  "schedule": {
                    "type": "object",
                    "properties": {
                      "date": { "type": "string", "format": "date" },
                      "timeSlot": { "type": "string" }
                    }
                  }
                },
                "required": ["courseId", "instructorId", "schedule"]
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "Booking created",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "_id": { "type": "string" },
                    "userId": { "type": "string" },
                    "courseId": { "type": "string" },
                    "instructorId": { "type": "string" },
                    "schedule": {
                      "type": "object",
                      "properties": {
                        "date": { "type": "string", "format": "date" },
                        "timeSlot": { "type": "string" }
                      }
                    },
                    "status": { "type": "string" },
                    "paymentStatus": { "type": "string" }
                  }
                }
              }
            }
          },
          "400": {
            "description": "Invalid booking data"
          }
        }
      },
      "get": {
        "summary": "Get user bookings",
        "security": [{ "bearerAuth": [] }],
        "responses": {
          "200": {
            "description": "List of user bookings",
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": {
                    "type": "object",
                    "properties": {
                      "_id": { "type": "string" },
                      "userId": { "type": "string" },
                      "courseId": {
                        "type": "object",
                        "properties": {
                          "title": { "type": "string" }
                        }
                      },
                      "instructorId": {
                        "type": "object",
                        "properties": {
                          "name": { "type": "string" },
                          "email": { "type": "string" }
                        }
                      },
                      "schedule": {
                        "type": "object",
                        "properties": {
                          "date": { "type": "string", "format": "date" },
                          "timeSlot": { "type": "string" }
                        }
                      },
                      "status": { "type": "string" },
                      "paymentStatus": { "type": "string" }
                    }
                  }
                }
              }
            }
          }
        }
      }
    },
    "/api/bookings/{id}/status": {
      "put": {
        "summary": "Update booking status",
        "security": [{ "bearerAuth": [] }],
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": { "type": "string" }
          }
        ],
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "status": { "type": "string", "enum": ["pending", "confirmed", "completed", "cancelled"] }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Booking status updated",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "_id": { "type": "string" },
                    "status": { "type": "string" }
                  }
                }
              }
            }
          },
          "404": {
            "description": "Booking not found"
          }
        }
      }
    },
    "/api/bookings/{id}/cancel": {
      "put": {
        "summary": "Cancel a booking",
        "security": [{ "bearerAuth": [] }],
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": { "type": "string" }
          }
        ],
        "responses": {
          "200": {
            "description": "Booking cancelled",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "_id": { "type": "string" },
                    "status": { "type": "string" }
                  }
                }
              }
            }
          },
          "404": {
            "description": "Booking not found"
          }
        }
      }
    },
    "/api/payments": {
      "post": {
        "summary": "Process a payment",
        "security": [{ "bearerAuth": [] }],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "bookingId": { "type": "string" },
                  "amount": { "type": "number" },
                  "method": { "type": "string", "enum": ["stripe", "cash", "esewa"] },
                  "transactionId": { "type": "string" }
                },
                "required": ["bookingId", "amount", "method", "transactionId"]
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "Payment processed",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "_id": { "type": "string" },
                    "userId": { "type": "string" },
                    "bookingId": { "type": "string" },
                    "amount": { "type": "number" },
                    "method": { "type": "string" },
                    "status": { "type": "string" },
                    "transactionId": { "type": "string" }
                  }
                }
              }
            }
          },
          "400": {
            "description": "Invalid payment data"
          }
        }
      }
    },
    "/api/payments/{id}": {
      "get": {
        "summary": "Get payment status",
        "security": [{ "bearerAuth": [] }],
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": { "type": "string" }
          }
        ],
        "responses": {
          "200": {
            "description": "Payment details",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "_id": { "type": "string" },
                    "userId": { "type": "object", "properties": { "name": { "type": "string" }, "email": { "type": "string" } } },
                    "bookingId": { "type": "object", "properties": { "title": { "type": "string" } } },
                    "amount": { "type": "number" },
                    "method": { "type": "string" },
                    "status": { "type": "string" },
                    "transactionId": { "type": "string" }
                  }
                }
              }
            }
          },
          "404": {
            "description": "Payment not found"
          }
        }
      }
    },
    "/api/reviews": {
      "post": {
        "summary": "Submit a review",
        "security": [{ "bearerAuth": [] }],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "instructorId": { "type": "string" },
                  "courseId": { "type": "string" },
                  "rating": { "type": "number" },
                  "comment": { "type": "string" }
                },
                "required": ["instructorId", "courseId", "rating"]
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "Review submitted",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "_id": { "type": "string" },
                    "userId": { "type": "string" },
                    "instructorId": { "type": "string" },
                    "courseId": { "type": "string" },
                    "rating": { "type": "number" },
                    "comment": { "type": "string" }
                  }
                }
              }
            }
          },
          "400": {
            "description": "Invalid review data"
          }
        }
      }
    },
    "/api/reviews/instructor/{id}": {
      "get": {
        "summary": "Get reviews for an instructor",
        "security": [{ "bearerAuth": [] }],
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": { "type": "string" }
          }
        ],
        "responses": {
          "200": {
            "description": "List of reviews",
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": {
                    "type": "object",
                    "properties": {
                      "_id": { "type": "string" },
                      "userId": { "type": "object", "properties": { "name": { "type": "string" } } },
                      "instructorId": { "type": "string" },
                      "courseId": { "type": "string" },
                      "rating": { "type": "number" },
                      "comment": { "type": "string" }
                    }
                  }
                }
              }
            }
          }
        }
      }
    },
    "/api/documents/upload": {
      "post": {
        "summary": "Upload a document",
        "security": [{ "bearerAuth": [] }],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "type": { "type": "string", "enum": ["citizenship", "license", "passport"] },
                  "fileUrl": { "type": "string" }
                },
                "required": ["type", "fileUrl"]
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "Document uploaded",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "_id": { "type": "string" },
                    "userId": { "type": "string" },
                    "type": { "type": "string" },
                    "fileUrl": { "type": "string" },
                    "status": { "type": "string" }
                  }
                }
              }
            }
          },
          "400": {
            "description": "Invalid document data"
          }
        }
      }
    },
    "/api/documents/{id}/review": {
      "put": {
        "summary": "Review a document (Admin only)",
        "security": [{ "bearerAuth": [] }],
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": { "type": "string" }
          }
        ],
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "status": { "type": "string", "enum": ["pending", "approved", "rejected"] }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Document reviewed",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "_id": { "type": "string" },
                    "status": { "type": "string" },
                    "reviewedBy": { "type": "string" }
                  }
                }
              }
            }
          },
          "404": {
            "description": "Document not found"
          }
        }
      }
    },
    "/api/notifications": {
      "get": {
        "summary": "Get user notifications",
        "security": [{ "bearerAuth": [] }],
        "responses": {
          "200": {
            "description": "List of notifications",
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": {
                    "type": "object",
                    "properties": {
                      "_id": { "type": "string" },
                      "userId": { "type": "string" },
                      "message": { "type": "string" },
                      "type": { "type": "string" },
                      "isRead": { "type": "boolean" }
                    }
                  }
                }
              }
            }
          }
        }
      }
    },
    "/api/notifications/{id}/read": {
      "put": {
        "summary": "Mark notification as read",
        "security": [{ "bearerAuth": [] }],
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": { "type": "string" }
          }
        ],
        "responses": {
          "200": {
            "description": "Notification marked as read",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "_id": { "type": "string" },
                    "isRead": { "type": "boolean" }
                  }
                }
              }
            }
          },
          "404": {
            "description": "Notification not found"
          }
        }
      }
    }
  },
  "components": {
    "securitySchemes": {
      "bearerAuth": {
        "type": "http",
        "scheme": "bearer",
        "bearerFormat": "JWT"
      }
    }
  }
}